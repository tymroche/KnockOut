        <mxCell id="Yt4x-JG5JJWTB-zM41XD-49" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Game Sleep&lt;/h1&gt;&lt;p&gt;Game in deep sleep mode. Power LED Off, Display off, waiting to be woken by power button.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="30" y="230" as="geometry" />
        </mxCell>
        <mxCell id="Yt4x-JG5JJWTB-zM41XD-50" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Game Startup&lt;/h1&gt;&lt;p&gt;Initializes game. Detects &amp;amp; sets game mode, resets structs, initializes components.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="260" y="670" as="geometry" />
        </mxCell>
        <mxCell id="Yt4x-JG5JJWTB-zM41XD-54" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Game Running&lt;/h1&gt;&lt;p&gt;Game actively running.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;One-Shot:&amp;nbsp;&lt;/b&gt;Waits for interrupt of final value (strength score) filtered by DMA controller.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Running Average: &lt;/b&gt;Continuously receives&amp;nbsp;strength score to calculate a running average over the course of a time period.&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="180" x="480" y="670" as="geometry" />
        </mxCell>
        <mxCell id="Yt4x-JG5JJWTB-zM41XD-55" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Game Over&lt;/h1&gt;&lt;p&gt;Game over.&amp;nbsp;&lt;/p&gt;Readies final game score." vertex="1">
          <mxGeometry height="110" width="180" x="700" y="670" as="geometry" />
        </mxCell>
        <mxCell id="Yt4x-JG5JJWTB-zM41XD-56" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Game Display&lt;/h1&gt;&lt;p&gt;Displays Game Score.&lt;/p&gt;Receives final game score, counts up to final score (for visual effect) and displays score." vertex="1">
